# Copy this file to .env.local and fill in the values.

# Live site address (used for SEO links, sitemap and share images).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Booking emails are sent FROM this Gmail account (the app password must belong to it).
# GMAIL_APP_PASSWORD must be a Google "App password" (16 characters), not the normal password:
# Google Account > Security > 2-Step Verification (turn on) > App passwords.
GMAIL_USER=alldrivebtc@gmail.com
GMAIL_APP_PASSWORD=

# Where booking requests are delivered (defaults to alldrivebtc@gmail.com).
BOOKING_EMAIL_TO=alldrivebtc@gmail.com
