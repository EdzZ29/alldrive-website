# Copy this file to .env.local and fill in the values.

# Live site address (used for SEO links, robots.txt, sitemap.xml and share images).
# Defaults to https://www.alldrivebutuan.com; only set this if the domain changes.
# NEXT_PUBLIC_SITE_URL=https://www.alldrivebutuan.com

# Google Search Console > Add property > URL prefix > HTML tag:
# paste only the content="..." value from the meta tag Google gives you.
GOOGLE_SITE_VERIFICATION=

# Microsoft Clarity (visitor stats, heatmaps and session recordings): clarity.microsoft.com >
# New project > copy the Project ID (Settings > Overview, e.g. "abc123xyz0"). Read AT BUILD TIME,
# so on Vercel set it, then redeploy. Leave empty to turn Clarity off.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Everything goes by email; there is no backend or admin dashboard.
# Booking emails are sent FROM this Gmail account (the app password must belong to it).
# GMAIL_APP_PASSWORD must be a Google "App password" (16 characters), not the normal password:
# Google Account > Security > 2-Step Verification (turn on) > App passwords.
GMAIL_USER=alldrivebtc@gmail.com
GMAIL_APP_PASSWORD=
# Optional: a different email provider instead of Gmail (same login as above). SMTP_SECURE=true for port 465.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false

# New bookings and contact-form inquiries arrive in this inbox (defaults to alldrivebtc@gmail.com).
# Each booking email has an "Approve booking" button: it opens a page on this site where the team
# checks the car, price and pickup and sends the customer the "Booking approved" email.
BOOKING_EMAIL_TO=alldrivebtc@gmail.com
# Signs the "Approve booking" links so only links from real booking emails work. Optional: without
# it the Gmail app password is used. Changing it (or the app password) makes older links stop working.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BOOKING_APPROVE_SECRET=
# The customer gets a "we received your booking" email right away (if they left an email). Set to
# false to skip it.
# BOOKING_EMAIL_CONFIRM_CUSTOMER=true

# Maintenance page: every public page shows "We'll be right back" (booking approval links keep
# working). Off unless MAINTENANCE_MODE=on; change it in Vercel, then redeploy.
# MAINTENANCE_MODE=on
# Secret to see the real site while maintenance is on: open https://www.alldrivebutuan.com/?preview=<key>
# once in your browser (?preview=off to see the maintenance page again).
# MAINTENANCE_BYPASS_KEY=
