# Copy this file to .env.local and fill in the values.

# Live site address (used for SEO links, robots.txt, sitemap.xml and share images).
# Defaults to https://www.alldrivebutuan.com; only set this if the domain changes.
# NEXT_PUBLIC_SITE_URL=https://www.alldrivebutuan.com

# Google Search Console > Add property > URL prefix > HTML tag:
# paste only the content="..." value from the meta tag Google gives you.
GOOGLE_SITE_VERIFICATION=

# Admin dashboard (all-drive-backend). Every booking and contact-form inquiry is saved there so
# the team can manage it at /admin. ALLDRIVE_API_KEY must equal WEBSITE_API_KEY in the backend's
# .env. The key is used only on this site's server, never in the browser.
# ALLDRIVE_API_URL is also read AT BUILD TIME (next.config.ts forwards /admin's API calls to it),
# so on Vercel set it before deploying and redeploy after changing it. Use the backend's https URL.
ALLDRIVE_API_URL=http://localhost:5000
ALLDRIVE_API_KEY=

# Booking emails are sent FROM this Gmail account (the app password must belong to it).
# GMAIL_APP_PASSWORD must be a Google "App password" (16 characters), not the normal password:
# Google Account > Security > 2-Step Verification (turn on) > App passwords.
GMAIL_USER=alldrivebtc@gmail.com
GMAIL_APP_PASSWORD=

# Bookings and inquiries go to the admin dashboard. This inbox only gets them as a BACKUP, when
# the dashboard can't be reached (defaults to alldrivebtc@gmail.com).
BOOKING_EMAIL_TO=alldrivebtc@gmail.com
# The customer gets a "we received your booking" email right away (if they left an email), and a
# "booking confirmed" email from the dashboard when an admin approves it. Set to false to skip the
# first one.
# BOOKING_EMAIL_CONFIRM_CUSTOMER=true

# Maintenance page: every public page shows "We'll be right back" (the admin dashboard keeps
# working). Off unless MAINTENANCE_MODE=on; change it in Vercel, then redeploy.
# MAINTENANCE_MODE=on
# Secret to see the real site while maintenance is on: open https://www.alldrivebutuan.com/?preview=<key>
# once in your browser (?preview=off to see the maintenance page again).
# MAINTENANCE_BYPASS_KEY=
