# Copy this file to .env.local and fill in the values.

# Live site address (used for SEO links, robots.txt, sitemap.xml and share images).
# Defaults to https://www.alldrivebutuan.com; only set this if the domain changes.
# NEXT_PUBLIC_SITE_URL=https://www.alldrivebutuan.com

# Google Search Console > Add property > URL prefix > HTML tag:
# paste only the content="..." value from the meta tag Google gives you.
GOOGLE_SITE_VERIFICATION=

# Booking emails are sent FROM this Gmail account (the app password must belong to it).
# GMAIL_APP_PASSWORD must be a Google "App password" (16 characters), not the normal password:
# Google Account > Security > 2-Step Verification (turn on) > App passwords.
GMAIL_USER=alldrivebtc@gmail.com
GMAIL_APP_PASSWORD=

# Where booking requests are delivered (defaults to alldrivebtc@gmail.com).
BOOKING_EMAIL_TO=alldrivebtc@gmail.com

# Booking text messages (SMS) through Semaphore: semaphore.co > sign up > load credits >
# Account > API Key. Leave empty to send email only.
SEMAPHORE_API_KEY=
# Optional approved sender name (Semaphore > Sender Names). Empty = Semaphore's default "SEMAPHORE".
SEMAPHORE_SENDER_NAME=
# Team numbers texted for every booking, comma-separated (defaults to 0946 126 0177 and 0956 227 5764).
# BOOKING_SMS_TO=09461260177,09562275764
# The customer also gets a "we received your booking" text. Set to false to turn that off.
# BOOKING_SMS_CONFIRM_CUSTOMER=true
